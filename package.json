{
  "private": true,
  "name": "ai-repo",
  "scripts": {
    "build": "turbo build --concurrency 16",
    "build:examples": "turbo build --filter=@example/*",
    "build:packages": "turbo build --filter=@ai-sdk/* --filter=ai",
    "benchmark:memory": "node tools/memory-benchmark/src/cli.mjs",
    "changeset": "changeset",
    "clean": "turbo clean",
    "dev": "turbo dev --cache=local:r,remote:r --concurrency 25 --continue",
    "prepare": "husky",
    "type-check": "turbo run type-check --filter=./packages/*",
    "type-check:full": "turbo run type-check",
    "publint": "turbo publint",
    "test": "turbo test --concurrency 16 --filter=!@example/*",
    "test:bundlers": "node tools/bundler-tests/run.mjs",
    "test:ci": "turbo run ci:checks --filter=!@example/* --concurrency=100% --continue=dependencies-successful",
    "test:update": "turbo test:update --concurrency 16 --filter=!@example/*",
    "ci:release": "turbo clean && npm run build:packages && changeset publish",
    "ci:version": "changeset version && node .github/scripts/cleanup-examples-changesets.mjs && pnpm install --no-frozen-lockfile",
    "clean-examples": "node .github/scripts/cleanup-examples-changesets.mjs && pnpm install --no-frozen-lockfile",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "validate:docs": "node tools/validate-properties-tables.mjs",
    "konsistent": "turbo run konsistent:validate konsistent:check --log-order=grouped --log-prefix=none",
    "konsistent:check": "konsistent --config-path .github/konsistent.json",
    "konsistent:validate": "konsistent validate --config-path .github/konsistent.json",
    "worktree:setup": "bash tools/worktree-setup.sh",
    "ci:check": "turbo run build type-check check validate:docs konsistent:check konsistent:validate test:site check-bundle-size test:bundlers --filter=!@example/* --concurrency=100% --continue=dependencies-successful",
    "ci:test": "turbo run test test:integration --filter=!@example/* --concurrency=100% --continue=dependencies-successful",
    "ci:examples": "turbo run build type-check --filter=@example/* --concurrency=2 --continue=dependencies-successful",
    "ci:browser": "turbo run test:browser --filter=@ai-sdk/rsc --filter=@ai-sdk/devtools --concurrency=2 --continue=dependencies-successful",
    "benchmark:load-time": "node tools/ci/check-load-time.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "ultracite fix"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@playwright/test": "^1.61.1",
    "del-cli": "^5.1.0",
    "husky": "^9.1.7",
    "konsistent": "1.0.0-beta.11",
    "konsistent-provider": "workspace:*",
    "lint-staged": "^15.5.1",
    "next": "16.3.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "playwright": "^1.61.1",
    "publint": "0.2.12",
    "react": "19.0.0-rc-cc1ec60d0d-20240607",
    "react-dom": "19.0.0-rc-cc1ec60d0d-20240607",
    "semver": "^7.8.5",
    "turbo": "2.9.14",
    "typescript": "6.0.3",
    "ultracite": "7.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "homepage": "https://ai-sdk.dev/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/ai"
  },
  "license": "Apache License",
  "bugs": {
    "url": "https://github.com/vercel/ai/issues"
  },
  "keywords": [
    "ai"
  ],
  "packageManager": "pnpm@12.14.0"
}
