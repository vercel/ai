# This file is scoped to tools/memory-benchmark.
# Copy it to .env and fill only the benchmarks your team intends to run.
# The CLI soft-skips benchmarks whose required values are blank.

# Shared Anthropic key:
# - SuperDesign
# - Neovate Code
ANTHROPIC_API_KEY=

# Scira: fixed temporary-chat benchmark using scira-default (xAI).
XAI_API_KEY=
SCIRA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scira_benchmark
# Generate with: openssl rand -hex 32
SCIRA_BETTER_AUTH_SECRET=
# Optional override; defaults to http://localhost:3000/api/search
SCIRA_BENCH_URL=

