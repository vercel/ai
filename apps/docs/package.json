{
  "name": "ai-sdk-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for the AI SDK (ai-sdk.dev), built with @vercel/geistdocs.",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "build-search-index": "node scripts/build-search-index.mjs",
    "dev:site": "pnpm sync-content --dev && fumadocs-mdx && next dev",
    "build:site": "pnpm sync-content && fumadocs-mdx && pnpm build-search-index && next build",
    "start:site": "next start",
    "type-check:site": "pnpm sync-content && fumadocs-mdx && tsc --noEmit",
    "test:site": "node --test scripts/*.test.mjs",
    "validate:site": "pnpm test:site && pnpm build:site"
  },
  "dependencies": {
    "@ai-sdk/mcp": "workspace:*",
    "@ai-sdk/react": "workspace:*",
    "@shikijs/langs": "3.23.0",
    "@shikijs/transformers": "3.23.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/geistdocs": "3.0.4",
    "ai": "workspace:*",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4",
    "fumadocs-ui": "16.2.2",
    "lucide-react": "^0.555.0",
    "motion": "^12.42.2",
    "next": "16.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "satori": "^0.63.2",
    "shiki": "3.23.0",
    "streamdown": "^2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.19.19",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "js-yaml": "4.3.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  }
}
