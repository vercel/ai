{
  "name": "@ai-sdk/tools",
  "version": "0.0.0",
  "description": "First-party, provider-independent tools for the AI SDK",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "files": [
    "dist/**/*",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "import": "./dist/bash/index.js",
      "default": "./dist/bash/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsdown",
    "build:watch": "tsdown --watch",
    "clean": "del-cli *.tsbuildinfo",
    "type-check": "tsc --build",
    "test": "pnpm test:node",
    "test:node": "vitest --config vitest.node.config.js --run",
    "test:watch": "vitest --config vitest.node.config.js"
  },
  "dependencies": {
    "just-bash": "^3.0.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "ai": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@vercel/ai-tsconfig": "workspace:*",
    "ai": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ai-sdk.dev/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/ai",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/vercel/ai/issues"
  }
}
