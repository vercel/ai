{
  "name": "@ai-sdk/inference-coop",
  "version": "2.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "docs/**/*",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/__snapshots__",
    "!src/**/__fixtures__",
    "CHANGELOG.md",
    "README.md"
  ],
  "directories": {
    "doc": "./docs"
  },
  "scripts": {
    "build": "pnpm clean && tsdown",
    "build:watch": "pnpm clean && tsdown --watch",
    "clean": "del-cli docs *.tsbuildinfo",
    "prepack": "mkdir -p docs && cp ../../content/providers/01-ai-sdk-providers/230-inference-coop.mdx ./docs/",
    "postpack": "del-cli docs",
    "type-check": "tsc --build",
    "test": "pnpm test:node && pnpm test:edge",
    "test:update": "pnpm test:node -u",
    "test:watch": "vitest --config vitest.node.config.js",
    "test:edge": "vitest --config vitest.edge.config.js --run",
    "test:node": "vitest --config vitest.node.config.js --run"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "workspace:*",
    "@ai-sdk/provider": "workspace:*",
    "@ai-sdk/provider-utils": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "workspace:*",
    "@types/node": "22.19.19",
    "@vercel/ai-tsconfig": "workspace:*",
    "@vercel/ai-tsdown-config": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://ai-sdk.dev/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/ai",
    "directory": "packages/inference-coop"
  },
  "bugs": {
    "url": "https://github.com/vercel/ai/issues"
  },
  "keywords": [
    "ai"
  ],
  "description": "The **Inference Cooperative provider** for the [AI SDK](https://ai-sdk.dev/docs) provides chat, image generation, transcription, and speech models through the [Inference Cooperative](https://inference.coop)'s member-governed, OpenAI-compatible gateway."
}
