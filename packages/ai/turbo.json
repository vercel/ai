    "test:edge": {
      "env": [
        "$TURBO_EXTENDS$",
        "VITEST_SHARD"
      ],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tools/ci/run-vitest-shard.mjs"
      ]
    }
  }
}
