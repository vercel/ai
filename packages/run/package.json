{
  "name": "run",
  "version": "1.5.0",
  "description": "Secure QuickJS-backed JavaScript runtime with host functions and continuations",
  "keywords": [
    "javascript",
    "quickjs",
    "runtime",
    "sandbox",
    "workers"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsup --tsconfig tsconfig.build.json && node scripts/embed-inline-worker.mjs",
    "build:watch": "node scripts/build-watch.mjs",
    "clean": "del-cli dist *.tsbuildinfo",
    "type-check": "tsc -p tsconfig.build.json --noEmit && tsc -p src/tsconfig.json",
    "test": "pnpm test:node",
    "test:hardening": "pnpm build && vitest --config vitest.node.config.js --run",
    "test:watch": "vitest --config vitest.node.config.js",
    "test:node": "vitest --config vitest.node.config.js --run",
    "hardening:fuzz": "pnpm build && node scripts/hardening-fuzz.mjs",
    "hardening:soak": "pnpm build && node --expose-gc scripts/hardening-soak.mjs",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:package": "pnpm build && pnpm type-check && node scripts/verify-embedded-worker.mjs && node scripts/verify-package.mjs",
    "prepack": "node scripts/verify-embedded-worker.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@vercel/ai-tsconfig": "workspace:*",
    "devalue": "5.8.2",
    "esbuild": "^0.28.1",
    "quickjs-emscripten": "0.32.0",
    "tsup": "^8.5.1",
    "typescript": "5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/vercel/ai/tree/main/packages/run",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel/ai",
    "directory": "packages/run"
  },
  "bugs": {
    "url": "https://github.com/vercel/ai/issues"
  }
}
