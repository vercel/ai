    "type": "text-delta",
  },
  {
    "delta": " are voting",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " in a",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " highly consequential",
