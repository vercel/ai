    "type": "text-delta",
  },
  {
    "delta": " election,",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " the first since",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " the October ",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": "7 attacks.",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " Record voter turnout",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " is reported,",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " the highest in",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " decades, as Prime",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " Minister Benjamin Netanyahu's",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " political future hangs in",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " the balance. The vote",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " is widely seen as a",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " referendum on Netanyahu's leadership",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " and his handling of ongoing conflicts",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": ", including the",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " Iran war. Tens of thousands",
