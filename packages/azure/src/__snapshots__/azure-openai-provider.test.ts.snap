    "type": "text-delta",
  },
  {
    "delta": "7 attacks.",
    "id": "msg_0d2f27550f7252c9006ae0f4e2cf408193882e4587babec7ad",
    "type": "text-delta",
  },
  {
    "delta": " Record voter turnout",
