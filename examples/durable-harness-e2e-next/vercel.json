{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/pi/drive-queue/route.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "__harnesspi_wkf_workflow_*",
          "retryAfterSeconds": 5,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/fx/drive-queue/route.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "__harnessfx_wkf_workflow_*",
          "retryAfterSeconds": 5,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
