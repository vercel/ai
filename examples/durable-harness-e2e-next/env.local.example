# Vercel OIDC token, necessary for Vercel Sandbox (and AI Gateway when
# AI_GATEWAY_API_KEY is not set). Pull it with `vercel env pull`.
VERCEL_OIDC_TOKEN=xxxxxxx

# AI Gateway credential used by the Pi and fx harnesses.
AI_GATEWAY_API_KEY=xxxxxxx

# Optional: force a specific World (`local` or `vercel`). Defaults to
# `vercel` when running on Vercel and `local` everywhere else.
HARNESS_WORLD=
