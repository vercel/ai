{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "esnext",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "rootDir": ".",
    "outDir": "./build",
    "skipLibCheck": true
  },
  "include": [
    "agents/**/*.ts",
    "harness/**/*.ts",
    "lib/**/*.ts"
  ]
}
