{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CI",
    "RUNNER_OS",
    "RUNNER_ARCH"
  ],
  "tasks": {
    "validate": {
      "dependsOn": [
        "build",
        "type-check",
        "check-bundle-size"
      ]
    },
    "//#validate": {
      "dependsOn": [
        "//#check",
        "//#validate:docs",
        "//#konsistent:check",
        "//#konsistent:validate",
        "//#test:bundlers",
        "ai-sdk-docs#test:site"
      ]
    },
    "//#check": {},
    "//#validate:docs": {
      "inputs": [
        "tools/validate-properties-tables.mjs",
        "content/**/*.mdx"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "AI_GATEWAY_API_KEY",
        "AI_SDK_DEVTOOLS_PORT",
        "ALIBABA_API_KEY",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MICROSOFT_RESOURCE_NAME",
        "ANTHROPIC_MICROSOFT_API_KEY",
        "ARK_API_KEY",
        "ASSISTANT_ID",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AZURE_RESOURCE_NAME",
        "AZURE_API_KEY",
        "BASETEN_API_KEY",
        "CEREBRAS_API_KEY",
        "COHERE_API_KEY",
        "DEEPINFRA_API_KEY",
        "DEEPSEEK_API_KEY",
        "ELEVENLABS_API_KEY",
        "FAL_KEY",
        "FAL_API_KEY",
        "FIREWORKS_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLIENT_EMAIL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GOOGLE_PRIVATE_KEY",
        "GOOGLE_PRIVATE_KEY_ID",
        "GOOGLE_VERTEX_API_KEY",
        "GOOGLE_VERTEX_LOCATION",
        "GOOGLE_VERTEX_PROJECT",
        "GMI_CLOUD_APIKEY",
        "GROQ_API_KEY",
        "KLINGAI_ACCESS_KEY",
        "KLINGAI_API_KEY",
        "KLINGAI_SECRET_KEY",
        "LUMA_API_KEY",
        "MISTRAL_API_KEY",
        "NEXT_RUNTIME",
        "NIM_API_KEY",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_API_BASE",
        "OPENAI_BASE_URL",
        "PERPLEXITY_API_KEY",
        "REPLICATE_API_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TOGETHER_API_KEY",
        "TOGETHER_AI_API_KEY",
        "TOPAZ_API_KEY",
        "HEYGEN_API_KEY",
        "VERCEL_API_KEY",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_ENV",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_REGION",
        "VERCEL_URL",
        "TYPESAFE_AI_API_KEY",
        "XAI_API_KEY",
        "ZAI_API_KEY"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".nuxt/**",
        ".svelte-kit/**",
        ".vinxi/**",
        "!.next/dev/**",
        ".vercel/output/**",
        ".output/**",
        "dist-ssr/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "type-check": {
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "VITEST_MAX_WORKERS",
        "TEST_NODE_VERSION"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/setup-download-fetch.node.js"
      ]
    },
    "test:node": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "VITEST_MAX_WORKERS",
        "TEST_NODE_VERSION"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/setup-download-fetch.node.js"
      ]
    },
    "test:edge": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "VITEST_MAX_WORKERS",
        "TEST_NODE_VERSION"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/setup-download-fetch.node.js"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "VITEST_MAX_WORKERS",
        "TEST_NODE_VERSION"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/setup-download-fetch.node.js"
      ],
      "outputs": [
        "test-results.json",
        "test-results/**",
        "playwright-report/**"
      ]
    },
    "check-bundle-size": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist-bundle-check/**"
      ]
    },
    "//#test:bundlers": {
      "dependsOn": [
        "ai#build",
        "@ai-sdk/openai#build"
      ],
      "inputs": [
        "tools/bundler-tests/**",
        "content/docs/**",
        "content/providers/01-ai-sdk-providers/03-openai.mdx"
      ],
      "env": [
        "TEST_NODE_VERSION"
      ]
    },
    "test:update": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "publint": {
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#konsistent:check": {
      "dependsOn": [
        "konsistent-provider#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!content/**",
        "!examples/**",
        "!apps/**"
      ]
    },
    "//#konsistent:validate": {
      "dependsOn": [
        "konsistent-provider#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!content/**",
        "!examples/**",
        "!apps/**"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "TEST_NODE_VERSION"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "TEST_NODE_VERSION",
        "PLAYWRIGHT_IMAGE",
        "PORT"
      ],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ],
      "outputs": [
        "test-results.json",
        "test-results/**",
        "playwright-report/**"
      ]
    },
    "//#benchmark:load-time": {
      "dependsOn": [
        "ai#build",
        "@ai-sdk/openai#build",
        "@ai-sdk/openai-compatible#build",
        "@ai-sdk/anthropic#build",
        "@ai-sdk/google#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "GITHUB_STEP_SUMMARY"
      ]
    }
  }
}
