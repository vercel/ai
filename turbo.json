{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    // Packages without a script for a task don't pull in that task's dependencies.
    "strictTaskEntrypointSelection": true
  },
  "globalEnv": ["CI", "PORT"],
  "globalPassThroughEnv": ["pnpm_config_verify_deps_before_run"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AI_GATEWAY_API_KEY",
        "AI_SDK_DEVTOOLS_PORT",
        "ALIBABA_API_KEY",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MICROSOFT_RESOURCE_NAME",
        "ANTHROPIC_MICROSOFT_API_KEY",
        "ARK_API_KEY",
        "ASSISTANT_ID",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AZURE_RESOURCE_NAME",
        "AZURE_API_KEY",
        "BASETEN_API_KEY",
        "CEREBRAS_API_KEY",
        "COHERE_API_KEY",
        "DEEPINFRA_API_KEY",
        "DEEPSEEK_API_KEY",
        "ELEVENLABS_API_KEY",
        "FAL_KEY",
        "FAL_API_KEY",
        "FIREWORKS_API_KEY",
        "GOOGLE_API_KEY",
        "GOOGLE_APPLICATION_CREDENTIALS",
        "GOOGLE_CLIENT_EMAIL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GOOGLE_PRIVATE_KEY",
        "GOOGLE_PRIVATE_KEY_ID",
        "GOOGLE_VERTEX_API_KEY",
        "GOOGLE_VERTEX_LOCATION",
        "GOOGLE_VERTEX_PROJECT",
        "GMI_CLOUD_APIKEY",
        "GROQ_API_KEY",
        "KLINGAI_ACCESS_KEY",
        "KLINGAI_API_KEY",
        "KLINGAI_SECRET_KEY",
        "LIQUID_API_KEY",
        "LUMA_API_KEY",
        "MISTRAL_API_KEY",
        "NEXT_RUNTIME",
        "NIM_API_KEY",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_API_BASE",
        "OPENAI_BASE_URL",
        "PERPLEXITY_API_KEY",
        "REPLICATE_API_TOKEN",
        "SCALEDOWN_API_KEY",
        "SILICONFLOW_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "TENCENTCLOUD_SECRET_ID",
        "TENCENTCLOUD_SECRET_KEY",
        "TENCENTCLOUD_SESSION_TOKEN",
        "TENCENTCLOUD_VOD_SUB_APP_ID",
        "TENCENT_TOKENHUB_API_KEY",
        "TOGETHER_API_KEY",
        "TOGETHER_AI_API_KEY",
        "TOPAZ_API_KEY",
        "HEYGEN_API_KEY",
        "VERCEL_API_KEY",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_ENV",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_REGION",
        "VERCEL_URL",
        "TYPESAFE_AI_API_KEY",
        "XAI_API_KEY",
        "ZAI_API_KEY"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".nuxt/**",
        ".svelte-kit/**",
        ".vinxi/**"
      ],
      "tags": ["ci", "ci:cpus:4"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "tags": ["ci"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": ["TEST_NODE_VERSION"],
      "passThroughEnv": ["VITEST_MAX_WORKERS"],
      "tags": ["ci"]
    },
    "test:browser": {
      "dependsOn": ["^build", "build"],
      "outputs": [
        "test-results/**",
        "test-results.json",
        "playwright-report/**"
      ],
      "tags": ["ci", "ci:os:ubuntu", "ci:cpus:4"]
    },
    "test:windows": {
      "dependsOn": ["^build", "build"]
    },
    "test:bundlers": {
      "dependsOn": ["^build"],
      "tags": ["ci", "ci:cpus:4"]
    },
    "test:load-time": {
      "dependsOn": ["^build"],
      "tags": ["ci"]
    },
    "check-bundle-size": {
      "dependsOn": ["^build"],
      "outputs": ["dist-bundle-check/**"],
      "tags": ["ci"]
    },
    "test:update": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "publint": {
      "dependsOn": ["^build", "build"]
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#check": {
      "cache": false,
      "tags": ["ci", "ci:cpus:4"]
    },
    "//#run-verifiers": {
      "cache": false,
      "tags": ["ci"]
    },
    "//#validate:docs": {
      "cache": false,
      "tags": ["ci"]
    },
    "//#verify:model-capabilities-docs": {
      "cache": false,
      "tags": ["ci"]
    },
    "//#test:tarballs": {
      "cache": false,
      "tags": ["ci"]
    },
    "//#konsistent:check": {
      "dependsOn": ["konsistent-provider#build"],
      "cache": false,
      "tags": ["ci"]
    },
    "//#konsistent:validate": {
      "dependsOn": ["konsistent-provider#build"],
      "cache": false,
      "tags": ["ci"]
    }
  }
}
